# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tena_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tena_ai

# Google Gemini Pro API Key (from Google AI Studio / Google Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=tena_ai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=7d

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# TestMail / Nodemailer Email Service (optional for booking notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=5867
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Tena AI Health" <no-reply@tena.ai>

# Appwrite Cloud (optional storage / BaaS)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key
